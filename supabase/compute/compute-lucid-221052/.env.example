# Supabase Postgres connection string (Dashboard > Connect).
# Use the Session pooler (port 5432) or the direct connection.
# The Transaction pooler (port 6543) won't work: OpenWorkflow uses prepared statements and transactions.
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@[POOLER_HOST]:5432/postgres?sslmode=require

# Port the API listens on.
PORT=3000
